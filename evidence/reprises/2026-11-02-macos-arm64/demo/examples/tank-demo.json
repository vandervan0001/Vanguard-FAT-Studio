  "scenarios": [
    {
      "id": "reference",
      "name": "01 · Cycle de référence",
      "description": "Remplir la cuve depuis 25 %, constater la marche et l'augmentation du niveau puis l'arrêt à 70 %. Les seuils d'assertion sont adaptés au contrôleur de démonstration ; les adapter au programme PLC réel.",
      "duration_s": 32.0,
      "steps": [
        {
          "at_s": 0.0,
          "action": "marker",
          "target": "",
          "value": null,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Début du cycle de référence, cuve initiale 25 %."
        },
        {
          "at_s": 5.0,
          "action": "expect",
          "target": "pump_running",
          "value": true,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "La pompe retourne sa marche."
        },
        {
          "at_s": 10.0,
          "action": "expect",
          "target": "level",
          "value": 35.0,
          "operator": "gt",
          "tolerance": 0.001,
          "message": "Le niveau augmente réellement."
        },
        {
          "at_s": 25.0,
          "action": "expect",
          "target": "pump_cmd",
          "value": false,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Arrêt de remplissage après le seuil haut de contrôle."
        },
        {
          "at_s": 30.0,
          "action": "expect",
          "target": "level",
          "value": 60.0,
          "operator": "gt",
          "tolerance": 0.001,
          "message": "Le soutirage reste limité après l'arrêt."
        },
        {
          "at_s": 32.0,
          "action": "marker",
          "target": "",
          "value": null,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Fin de scénario : relever le résultat de la FAT."
        }
      ]
    },
    {
      "id": "motor-trip",
      "name": "02 · Défaut moteur et reprise",
      "description": "Déclenchement moteur à 5 s, contrôle retour et défaut, suppression à 15 s puis observation de la reprise.",
      "duration_s": 28.0,
      "steps": [
        {
          "at_s": 0.0,
          "action": "marker",
          "target": "",
          "value": null,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Vérification du défaut moteur P-101."
        },
        {
          "at_s": 5.0,
          "action": "fault",
          "target": "P101",
          "value": {
            "kind": "motor_trip"
          },
          "operator": "eq",
          "tolerance": 0.001,
          "message": ""
        },
        {
          "at_s": 6.0,
          "action": "expect",
          "target": "pump_running",
          "value": false,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Perte du retour marche."
        },
        {
          "at_s": 6.0,
          "action": "expect",
          "target": "pump_fault",
          "value": true,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Défaut transmis au PLC."
        },
        {
          "at_s": 10.0,
          "action": "expect",
          "target": "level",
          "value": 40.0,
          "operator": "lt",
          "tolerance": 0.001,
          "message": "Aucun remplissage caché pendant le défaut."
        },
        {
          "at_s": 15.0,
          "action": "clear_fault",
          "target": "P101",
          "value": null,
          "operator": "eq",
          "tolerance": 0.001,
          "message": ""
        },
        {
          "at_s": 17.0,
          "action": "expect",
          "target": "pump_running",
          "value": true,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Reprise après disparition du défaut."
        },
        {
          "at_s": 25.0,
          "action": "expect",
          "target": "level",
          "value": 40.0,
          "operator": "gt",
          "tolerance": 0.001,
          "message": "Reprise du remplissage observable."
        }
      ]
    },
    {
      "id": "sensor-freeze",
      "name": "03 · Capteur figé puis libéré",
      "description": "Figer LT-101 à 40 %, constater la mesure fixe, puis libérer le capteur. Le volume réel continue d'évoluer pendant le défaut.",
      "duration_s": 24.0,
      "steps": [
        {
          "at_s": 5.0,
          "action": "fault",
          "target": "LT101",
          "value": {
            "kind": "sensor_stuck",
            "value": 40.0
          },
          "operator": "eq",
          "tolerance": 0.001,
          "message": ""
        },
        {
          "at_s": 10.0,
          "action": "expect",
          "target": "level",
          "value": 40.0,
          "operator": "eq",
          "tolerance": 0.001,
          "message": "Mesure figée à 40 %."
        },
        {
          "at_s": 14.0,
          "action": "expect",
          "target": "volume",
          "value": 450.0,
          "operator": "gt",
          "tolerance": 0.001,
          "message": "Le procédé continue d'évoluer malgré la mesure figée."
        },
        {
          "at_s": 15.0,
          "action": "clear_fault",
          "target": "LT101",
          "value": null,
          "operator": "eq",
          "tolerance": 0.001,
          "message": ""
        },
        {
          "at_s": 16.0,
          "action": "expect",
          "target": "level",
          "value": 50.0,
          "operator": "gt",
          "tolerance": 0.001,
          "message": "Retour à la mesure du procédé."
        }
      ]
    }
  ],
