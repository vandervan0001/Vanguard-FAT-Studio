{
  "$defs": {
    "Animation": {
      "additionalProperties": false,
      "description": "Read-only visual binding; it never changes a process command or a tag.",
      "properties": {
        "tag_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Tag Id",
          "type": "string"
        },
        "operator": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "default": true,
          "title": "Value"
        },
        "effect": {
          "default": "highlight",
          "enum": [
            "highlight",
            "pulse",
            "rotate",
            "level",
            "position"
          ],
          "title": "Effect",
          "type": "string"
        },
        "min": {
          "default": 0.0,
          "title": "Min",
          "type": "number"
        },
        "max": {
          "default": 100.0,
          "title": "Max",
          "type": "number"
        },
        "active_color": {
          "default": "#148b78",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Active Color",
          "type": "string"
        },
        "inactive_color": {
          "default": "#738994",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Inactive Color",
          "type": "string"
        }
      },
      "required": [
        "tag_id"
      ],
      "title": "Animation",
      "type": "object"
    },
