{
  "$defs": {
    "Animation": {
      "additionalProperties": false,
      "description": "Read-only visual binding; it never changes a process command or a tag.",
      "properties": {
        "tag_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Tag Id",
          "type": "string"
        },
        "operator": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "default": true,
          "title": "Value"
        },
        "effect": {
          "default": "highlight",
          "enum": [
            "highlight",
            "pulse",
            "rotate",
            "level",
            "position"
          ],
          "title": "Effect",
          "type": "string"
        },
        "min": {
          "default": 0.0,
          "title": "Min",
          "type": "number"
        },
        "max": {
          "default": 100.0,
          "title": "Max",
          "type": "number"
        },
        "active_color": {
          "default": "#148b78",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Active Color",
          "type": "string"
        },
        "inactive_color": {
          "default": "#738994",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Inactive Color",
          "type": "string"
        }
      },
      "required": [
        "tag_id"
      ],
      "title": "Animation",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Target",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "directed": {
          "default": true,
          "title": "Directed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Equipment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "tank",
            "pump",
            "pump_vfd",
            "valve_onoff",
            "valve_control",
            "analog_sensor",
            "digital_sensor",
            "digital_input",
            "indicator"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 40,
          "title": "Unit",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "params": {
          "additionalProperties": true,
          "maxProperties": 30,
          "title": "Params",
          "type": "object"
        },
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 16,
          "title": "Bindings",
          "type": "object"
        },
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Animation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "name"
      ],
      "title": "Equipment",
      "type": "object"
    },
    "FatStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "instructions": {
          "default": "",
          "maxLength": 4000,
          "title": "Instructions",
          "type": "string"
        },
        "expected_result": {
          "default": "",
          "maxLength": 4000,
          "title": "Expected Result",
          "type": "string"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/PreparedAction"
          },
          "maxItems": 100,
          "title": "Actions",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/PreparedCheck"
          },
          "maxItems": 100,
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "FatStep",
      "type": "object"
    },
    "PLCConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "demo",
          "enum": [
            "demo",
            "opcua"
          ],
          "title": "Mode",
          "type": "string"
        },
        "demo_controller": {
          "default": "tank_level",
          "enum": [
            "tank_level",
            "manual_lab_v1"
          ],
          "title": "Demo Controller",
          "type": "string"
        },
        "tia_version": {
          "default": "V21",
          "enum": [
            "V20",
            "V21"
          ],
          "title": "Tia Version",
          "type": "string"
        },
        "endpoint": {
          "default": "opc.tcp://127.0.0.1:4840",
          "maxLength": 512,
          "title": "Endpoint",
          "type": "string"
        },
        "expected_application_uri": {
          "default": "",
          "maxLength": 512,
          "title": "Expected Application Uri",
          "type": "string"
        },
        "namespace_uri": {
          "default": "",
          "maxLength": 512,
          "title": "Namespace Uri",
          "type": "string"
        },
        "security_policy": {
          "default": "None",
          "enum": [
            "None",
            "Basic256Sha256"
          ],
          "title": "Security Policy",
          "type": "string"
        },
        "server_certificate_sha256": {
          "default": "",
          "maxLength": 95,
          "title": "Server Certificate Sha256",
          "type": "string"
        },
        "client_certificate": {
          "default": "",
          "maxLength": 1000,
          "title": "Client Certificate",
          "type": "string"
        },
        "client_private_key": {
          "default": "",
          "maxLength": 1000,
          "title": "Client Private Key",
          "type": "string"
        },
        "username_env": {
          "default": "",
          "maxLength": 128,
          "title": "Username Env",
          "type": "string"
        },
        "password_env": {
          "default": "",
          "maxLength": 128,
          "title": "Password Env",
          "type": "string"
        },
        "approved_virtual_target": {
          "default": "",
          "maxLength": 512,
          "title": "Approved Virtual Target",
          "type": "string"
        },
        "timeout_s": {
          "default": 3,
          "maximum": 30,
          "minimum": 0.2,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "title": "PLCConfig",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0,
          "maximum": 100000,
          "minimum": -100000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 100000,
          "minimum": -100000,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "Position",
      "type": "object"
    },
    "PreparedAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "force",
          "enum": [
            "force",
            "release"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Target",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "default": "native",
          "enum": [
            "native",
            "mA",
            "V",
            "engineering",
            "percent"
          ],
          "title": "Unit",
          "type": "string"
        },
        "diagnostic": {
          "default": false,
          "title": "Diagnostic",
          "type": "boolean"
        }
      },
      "required": [
        "target"
      ],
      "title": "PreparedAction",
      "type": "object"
    },
    "PreparedCheck": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Target",
          "type": "string"
        },
        "operator": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "tolerance": {
          "default": 0.001,
          "maximum": 1000000000.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "target",
        "value"
      ],
      "title": "PreparedCheck",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 10000,
          "title": "Description",
          "type": "string"
        },
        "simulation": {
          "$ref": "#/$defs/SimulationConfig"
        },
        "equipment": {
          "items": {
            "$ref": "#/$defs/Equipment"
          },
          "maxItems": 50,
          "title": "Equipment",
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "maxItems": 200,
          "title": "Connections",
          "type": "array"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "maxItems": 200,
          "title": "Tags",
          "type": "array"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "maxItems": 100,
          "title": "Scenarios",
          "type": "array"
        },
        "plc": {
          "$ref": "#/$defs/PLCConfig"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "requirement": {
          "default": "",
          "maxLength": 300,
          "title": "Requirement",
          "type": "string"
        },
        "preconditions": {
          "default": "",
          "maxLength": 2000,
          "title": "Preconditions",
          "type": "string"
        },
        "focus_equipment": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Focus Equipment",
          "type": "array"
        },
        "trend_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Trend Tags",
          "type": "array"
        },
        "execution_mode": {
          "default": "timed",
          "enum": [
            "timed",
            "guided"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "fat_steps": {
          "items": {
            "$ref": "#/$defs/FatStep"
          },
          "maxItems": 100,
          "title": "Fat Steps",
          "type": "array"
        },
        "duration_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Duration S",
          "type": "number"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ScenarioStep"
          },
          "maxItems": 2000,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "ScenarioStep": {
      "additionalProperties": false,
      "properties": {
        "at_s": {
          "maximum": 86400,
          "minimum": 0,
          "title": "At S",
          "type": "number"
        },
        "action": {
          "enum": [
            "force",
            "release",
            "fault",
            "clear_fault",
            "marker",
            "expect"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "default": "",
          "maxLength": 80,
          "title": "Target",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "operator": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le"
          ],
          "title": "Operator",
          "type": "string"
        },
        "tolerance": {
          "default": 0.001,
          "maximum": 1000000000.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "message": {
          "default": "",
          "maxLength": 4000,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "at_s",
        "action"
      ],
      "title": "ScenarioStep",
      "type": "object"
    },
    "SignalScaling": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "4-20mA",
            "0-10V",
            "linear"
          ],
          "title": "Kind",
          "type": "string"
        },
        "raw_min": {
          "default": 0.0,
          "title": "Raw Min",
          "type": "number"
        },
        "raw_max": {
          "default": 27648.0,
          "title": "Raw Max",
          "type": "number"
        },
        "engineering_min": {
          "default": 0.0,
          "title": "Engineering Min",
          "type": "number"
        },
        "engineering_max": {
          "default": 100.0,
          "title": "Engineering Max",
          "type": "number"
        },
        "engineering_unit": {
          "default": "%",
          "maxLength": 40,
          "title": "Engineering Unit",
          "type": "string"
        },
        "underflow_raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underflow Raw"
        },
        "overflow_raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overflow Raw"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SignalScaling",
      "type": "object"
    },
    "SimulationConfig": {
      "additionalProperties": false,
      "properties": {
        "step_ms": {
          "default": 100,
          "maximum": 2000,
          "minimum": 20,
          "title": "Step Ms",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "maximum": 20,
          "minimum": 0.1,
          "title": "Speed",
          "type": "number"
        }
      },
      "title": "SimulationConfig",
      "type": "object"
    },
    "Tag": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "data_type": {
          "enum": [
            "BOOL",
            "INT",
            "DINT",
            "REAL"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 40,
          "title": "Unit",
          "type": "string"
        },
        "initial_value": {
          "default": 0.0,
          "title": "Initial Value"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "node_id": {
          "default": "",
          "maxLength": 1000,
          "title": "Node Id",
          "type": "string"
        },
        "plc_address": {
          "default": "",
          "maxLength": 120,
          "title": "Plc Address",
          "type": "string"
        },
        "plc_symbol": {
          "default": "",
          "maxLength": 300,
          "title": "Plc Symbol",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalScaling"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "writable": {
          "default": false,
          "title": "Writable",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "direction",
        "data_type"
      ],
      "title": "Tag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "fat-studio/project",
      "default": "fat-studio/project",
      "title": "Format",
      "type": "string"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/Project"
    }
  },
  "required": [
    "project"
  ],
  "title": "ProjectPackage",
  "type": "object"
}
