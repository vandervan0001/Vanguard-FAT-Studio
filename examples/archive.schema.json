{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fat-studio.local/schemas/archive-1.0.json",
  "title": "FAT Studio archive manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "project_id",
    "files"
  ],
  "properties": {
    "format": {
      "const": "fat-studio/archive"
    },
    "version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2999,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
